---
import BaseLayout from '../layouts/BaseLayout.astro';
import units from '../data/portfolio.json';

const site = {
  name: "NIKHIL SARWARA",
  role: "Software Engineering (Honours) Graduate",
  location: "Melbourne, Australia",
  bio: "Graduated with First Class Honours in Software Engineering (Honours) @ Deakin. Focused on Robotics, Autonomous Systems, Cybersecurity, and Machine Learning. Thesis on GPS spoofing detection in mobile robots.",
  note: "This portfolio showcases my academic work only. For my personal projects and 5 years professional experience, email me at info@nikhilsarwara.com",
  phone: "0481756675",
  email: "info@nikhilsarwara.com",
  github: "https://github.com/Nikhil-Sarwara",
  linkedin: "https://linkedin.com/in/nikhil-sarwara/",
};

const stats = [
  { num: "∞", cap: "Projects" },
  { num: "37+", cap: "Technologies" },
  { num: "1", cap: "Experience" },
];

const stack = [
  { label: "Languages", items: ["C#", "C++", "Python", "TypeScript", "JavaScript", "SQL"], tone: "" },
  { label: "Frameworks & Libraries", items: [".NET Core", "React", "Next.js", "PyTorch", "SplashKit", "Flutter"], tone: "chip-blue" },
  { label: "Cloud & DevOps", items: ["AWS", "Docker", "Jenkins", "Firebase", "Git", "GitHub"], tone: "chip-dark" },
  { label: "Databases", items: ["MySQL", "PostgreSQL", "SQLite", "MongoDB", "Firestore"], tone: "" },
  { label: "Concepts", items: ["Computer Vision", "Machine Learning", "Full-stack", "IoT", "Agile/Scrum"], tone: "chip-purple" },
  { label: "Tools", items: ["Visual Studio", "VS Code", "Arduino IDE", "Raspberry Pi", "MQTT", "LaTeX"], tone: "" },
];

const unitLabels = {
  "SIT102": "CODE", "SIT111": "Systems", "SIT182": "Data Science", "SIT210": "CODE",
  "SIT218": "Robotics", "SIT223": "Profession", "SIT232": "CODE", "SIT310": "IoT",
  "SIT313": "Full-Stack", "SIT314": "Cloud", "SIT329": "Cybersec", "SIT331": "Backend",
  "SIT333": "Research", "SIT379": "Project Mgmt", "SIT723/SIT792": "Research T",
};

const buckets = [
  { name: "Programming & OOP", codes: ["SIT102", "SIT232"] },
  { name: "Systems & Hardware", codes: ["SIT111"] },
  { name: "Data Science", codes: ["SIT182"] },
  { name: "Embedded & IoT", codes: ["SIT210", "SIT310"] },
  { name: "Robotics", codes: ["SIT218"] },
  { name: "Web & Full-Stack", codes: ["SIT313", "SIT331"] },
  { name: "Cloud & DevOps", codes: ["SIT314", "SIT223"] },
  { name: "Cybersecurity", codes: ["SIT329"] },
  { name: "Research & Thesis", codes: ["SIT333", "SIT723/SIT792"] },
  { name: "Project Management", codes: ["SIT379"] },
];

const unitByCode = Object.fromEntries(units.map((u) => [u.unit_code, u]));

const experience = [
  {
    period: "2018",
    title: "Robotics Developer",
    org: "Kidobotics",
    desc: "Built \u201CVictory\u201D — a bomb-disposal & surveillance robot. 1st prize, 3rd National Level Junior Robotic Challenge (Bangalore).",
    evidence: [{ label: "The Tribune", url: "https://www.tribuneindia.com/news/archive/haryana-tribune/ambala-students-develop-bomb-disposal-robot-663689/" }],
    images: ["journey/tribune-clipping.jpg", "journey/tribune-photo.jpg"],
  },
  {
    period: "2019",
    title: "Robotics Developer & Workshop Mentor",
    org: "Kidobotics",
    desc: "Smart dustbin robot — solar powered, AI sensors, auto lid + GSM/SMS alerts. Took robotics workshops at public events.",
    evidence: [{ label: "Dainik Bhaskar", url: "https://www.bhaskar.com/haryana/ambala/news/haryana-news-bps-students-created-smart-dustbin-robot-071541-4371711.html" }],
    images: ["journey/bhaskar-clipping.jpg", "journey/workshop-2019.jpg"],
  },
  {
    period: "2019 \u2013 2022",
    title: "Ethical Hacker",
    org: "Client Work",
    desc: "Worked with clients on ethical hacking engagements.",
  },
  {
    period: "2022",
    title: "B.E. Computer Science",
    org: "Chitkara University",
    desc: "Started university; credits later transferred to Deakin.",
  },
  {
    period: "2024",
    title: "Forklift Driver & Manager",
    org: "MKM Tiles",
    desc: "Winter holidays — forklift operations and on-site management.",
  },
  {
    period: "2024 \u2013 2026",
    title: "B. Software Engineering (Honours)",
    org: "Deakin University",
    desc: "Graduated with First Class Honours. Minor in Cyber Security.",
    images: ["journey/australia-2024.jpg", "journey/first-car-2024.jpg"],
  },
  {
    period: "Alongside studies",
    title: "Console Operator (Casual — Night Shifts)",
    org: "7-Eleven",
    desc: "Casual night-shift job alongside university — cash handling, inventory, customer service.",
  },
  {
    period: "2025",
    title: "Van Driver",
    org: "DHL",
    desc: "Winter holidays — delivery operations.",
    images: ["journey/dhl-2025.jpg"],
  },
  {
    period: "2026",
    title: "Full Stack Developer — Remote Internship",
    org: "BibVault · Australia",
    desc: "Remote internship as a full stack developer during my final trimester.",
  },
];
---
<BaseLayout>
  <div class="page">
    <div class="corner-tl"></div>
    <div class="corner-br"></div>
    <div class="content">
      <div class="main-grid">

        <div class="honours-banner">
          <span class="hb-emoji">🎓</span>
          <span class="hb-text">Graduated with <strong>First Class Honours</strong> — Deakin University</span>
          <span class="hb-stars">★★★★★</span>
        </div>

        <!-- Identity -->
        <div class="cell cell-id">
          <div class="id-row">
            <div class="photo">
              <img src="/profile.png" alt={site.name} width="192" height="256" />
            </div>
            <div class="flex-1">
              <h1 class="name">{site.name}</h1>
              <p class="id-meta">{site.role} · {site.location}</p>
              <div class="honours-badge" id="honours-badge">
                <span class="hb-star">★</span>
                <div class="hb-inner">
                  <div class="hb-title">First Class Honours</div>
                  <div class="hb-sub">Bachelor of Software Engineering (Honours)</div>
                </div>
                <span class="hb-hint">proof ▾</span>
                <div class="proof-popover" id="proof-popover">
                  <div class="pp-label">Official Proof — Deakin University</div>
                  <a href="/proof/academic-transcript.pdf" target="_blank" rel="noopener">📄 Academic Transcript</a>
                  <a href="/proof/course-completion-graduation-status.pdf" target="_blank" rel="noopener">📜 Completion &amp; Graduation Status</a>
                </div>
              </div>
            </div>
          </div>
          <p class="id-bio">{site.bio}</p>
        </div>

        <!-- Contact -->
        <div class="cell cell-bg-zinc">
          <div class="section-label">[Contact]</div>
          <div class="contact-list">
            <div class="contact-row">
              <span class="label">Phone</span>
              <a class="value" href="tel:0481756675">{site.phone}</a>
            </div>
            <div class="contact-row location-row" id="location-row" title="View location">
              <span class="label">Location</span>
              <span class="value loc-value">Thomastown, Melbourne, AU <span class="loc-pin">📍</span></span>
            </div>
            <div class="contact-row">
              <span class="label">Email</span>
              <a class="value" href={`mailto:${site.email}`}>{site.email}</a>
            </div>
            <div class="contact-row">
              <span class="label">GitHub</span>
              <a class="value" href={site.github} target="_blank" rel="noopener">github.com/Nikhil-Sarwara</a>
            </div>
            <div class="contact-row">
              <span class="label">LinkedIn</span>
              <a class="value" href={site.linkedin} target="_blank" rel="noopener">in/nikhil-sarwara</a>
            </div>
          </div>
          <a class="resume-btn" href="/resume.pdf" download>Download Resume ↓</a>
        </div>

        <!-- Statistics -->
        <div class="cell cell-bg-grad">
          <div class="section-label">[Statistics]</div>
          <div class="stats">
            {
              stats.map((s) => (
                <div class="stat">
                  <div class="num">{s.num}</div>
                  <div class="cap">{s.cap}</div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Stack -->
        <div class="cell cell-bg-grad">
          <div class="section-label">[Stack]</div>
          {
            stack.map((g) => (
              <div class="stack-group">
                <div class="g-label">{g.label}</div>
                <div class="chips">
                  {g.items.map((i) => <span class={`chip ${g.tone}`}>{i}</span>)}
                </div>
              </div>
            ))
          }
        </div>

        <!-- Academic -->
        <div class="cell cell-wide">
          <div class="section-label">[Academic] Course Units</div>
          <div class="buckets">
            {
              buckets.map((b) => (
                <details class="bucket">
                  <summary>
                    <span class="b-name">{b.name}</span>
                    <span class="b-count">{b.codes.length} unit{b.codes.length > 1 ? "s" : ""} <span class="arrow">▸</span></span>
                  </summary>
                  <div class="bucket-units">
                    {
                      b.codes.map((code) => {
                        const u = unitByCode[code];
                        if (!u) return null;
                        return (
                          <a class="bucket-unit" href={`/units/${u.unit_code.toLowerCase()}`}>
                            <span class="u-left">
                              <span class="badge-code">{u.unit_code}</span>
                              <span class="u-name">{unitLabels[u.unit_code]} — {u.unit_name}</span>
                            </span>
                            <span class="u-meta"><span class="badge-grade">{u.grade.split(" ")[0]}</span> · {u.semester}</span>
                          </a>
                        );
                      })
                    }
                  </div>
                </details>
              ))
            }
          </div>
        </div>
        <!-- Experience Timeline -->
        <div class="cell cell-wide">
          <div class="section-label">[Experience] Timeline</div>
          <div class="timeline">
            {
              experience.map((e) => (
                <div class="tl-item">
                  <div class="tl-rail">
                    <span class="tl-dot"></span>
                  </div>
                  <div class="tl-body">
                    <div class="tl-period">{e.period}</div>
                    <div class="tl-title">{e.title}</div>
                    <div class="tl-org">{e.org}</div>
                    <p class="tl-desc">{e.desc}</p>
                    {
                      e.evidence && e.evidence.length > 0 && (
                        <div class="tl-evidence">
                          {e.evidence.map((ev) => <a href={ev.url} target="_blank" rel="noopener">📰 {ev.label} →</a>)}
                        </div>
                      )
                    }
                    {
                      e.images && e.images.length > 0 && (
                        <div class="tl-images">
                          {e.images.map((img) => (
                            <button class="tl-img" data-img={`/${img}`} type="button" title="Open full image" aria-label="Open full image">
                              <img src={`/${img}`} alt={`Evidence — ${e.title}`} loading="lazy" />
                            </button>
                          ))}
                        </div>
                      )
                    }
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <footer class="footer">
        <div class="footer-links">
          <a href={site.github} target="_blank" rel="noopener">GitHub</a>
          <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={`mailto:${site.email}`}>Email</a>
          <a href="/resume.pdf" download>Resume</a>
        </div>
        <span class="footer-note">© {new Date().getFullYear()} Nikhil Sarwara</span>
      </footer>
    </div>
  </div>

  <div class="modal-overlay" id="location-modal" aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <button class="modal-close" id="modal-close" aria-label="Close">✕</button>
      <div class="modal-head">
        <span class="modal-title" id="modal-title">📍 Thomastown, Melbourne, Australia</span>
      </div>
      <div class="modal-map-wrap">
        <iframe
          class="modal-map"
          id="modal-map"
          src="about:blank"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          title="Map of Thomastown, Melbourne, Australia"
        ></iframe>
      </div>
      <p class="modal-note">😄 For security reasons, I cannot share my ISP allocation.</p>
    </div>
  </div>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close">✕</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="Evidence image" />
  </div>

  <script>
    // Mobile/tap toggle for the proof popover (hover is desktop-only)
    const badge = document.getElementById('honours-badge');
    if (badge) {
      badge.addEventListener('click', (e) => {
        if (e.target.closest('a')) return; // let links open normally
        badge.classList.toggle('open');
      });
      document.addEventListener('click', (e) => {
        if (!badge.contains(e.target)) badge.classList.remove('open');
      });
    }

    // Location modal
    const modal = document.getElementById('location-modal');
    const locRow = document.getElementById('location-row');
    const closeBtn = document.getElementById('modal-close');
    const mapFrame = document.getElementById('modal-map');
    if (modal && locRow) {
      let mapLoaded = false;
      const open = () => {
        // load the map only on first click — nothing fetches until then
        if (!mapLoaded && mapFrame) {
          mapFrame.src = 'https://www.google.com/maps?q=-37.6811,145.0167&z=14&output=embed';
          mapLoaded = true;
        }
        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      };
      locRow.addEventListener('click', open);
      closeBtn?.addEventListener('click', close);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    }

    // Evidence image lightbox
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxClose = document.getElementById('lightbox-close');
    if (lightbox && lightboxImg) {
      const openLb = (src) => {
        lightboxImg.src = src;
        lightbox.classList.add('open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };
      const closeLb = () => {
        lightbox.classList.remove('open');
        lightbox.setAttribute('aria-hidden', 'true');
        lightboxImg.src = '';
        document.body.style.overflow = '';
      };
      document.querySelectorAll('.tl-img').forEach((btn) => {
        btn.addEventListener('click', () => openLb(btn.dataset.img));
      });
      lightboxClose?.addEventListener('click', closeLb);
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLb();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLb();
      });
    }
  </script>
</BaseLayout>
